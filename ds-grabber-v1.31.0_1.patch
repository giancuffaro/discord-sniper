 extension/content.js    |  2 ++
 extension/manifest.json |  8 ++++++-
 extension/popup.html    | 25 ++++++--------------
 extension/popup.js      | 31 ++++--------------------
 5 files changed, 70 insertions(+), 48 deletions(-)

