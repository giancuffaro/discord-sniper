# The alert tape (9/11): real bid/ask for every contract the rooms called,
# including the 289 in six weeks we never bought. Same class as option_tape
# — it grows every session, it can never be re-derived (Webull keeps no
# option tick history), and it must NOT go in git. Back it up like the tape.
alert_tape.csv
alert_tape.csv.*
alert_meta.csv
alert_meta.csv.*
# Telemetry (9/6). Our own measurements, same class as option_tape: they can
# never be re-derived from anywhere, and they must NOT go in git — that is
# exactly how archive/logs put 68 MB in .git. Back them up like the tape.
telemetry.csv
telemetry.csv.*
telemetry-test.csv
shadow_ratchet.csv
alert_decay.csv
alert_decay.csv.*
quote_shadow.csv
quote_shadow.csv.*
announcer.restart
.announcer-board-sig
bridge.restart

# 9/3 cleanup: archived logs/exports/one-offs. Kept on disk so nothing is
# lost, never committed — 187MB of rotated logs lived here at the start.
archive/
*.log.old
settings.json.bak
settings.json.tmp
state.json.bak

# Health-check trend log (our own measurements, regrows on demand)
health.csv
health.csv.*

