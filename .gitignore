master_ledger.csv
master_ledger.csv.*
master_alerts.csv
master_alerts.csv.*
master_broker.csv
master_broker.csv.*
backups/
.pytest_cache/

# 9/9: START HERE's one-shot open-rooms token — runtime, never code
open-rooms.request

# 9/9: per-machine bridge address + shared secret (second PC) — never in git
extension/bridge.txt
master_postmortems.csv
master_postmortems.csv.*
postmortems/

# 9/9: bought price bars (Databento 1-second stock bars for the pullback
# backtest) — data, re-buyable for cents, never code
bars/
databento_tape.coverage.json

# 9/11 SECURITY: the Webull SDK's own request log prints the live x-app-key in
# every signed header. "*.log" does NOT match the rotated names (they end in
# a date, not ".log"), so 18 of them were TRACKED and PUSHED TO THE PUBLIC REPO.
# Moved to archive/. The key in git HISTORY cannot be removed by ignoring it —
# it must be rotated at Webull.
webull_api.log
webull_api.log.*
webull_data_streaming_sdk.log*
reads.log*
deadman.log*
launcher-probe.log*
whop-loop.log*
