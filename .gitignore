__pycache__/
*.pyc
.venv/

# Log files, including the one the Webull SDK writes on its own. These are
# noise in a repo and they can quietly contain account ids, so they stay local.
*.log
webull_trade_sdk.log
trades.log

bridge.log
# Rotated generations: bridge.log.1/.2 from the launcher's rotation, and the
# dated files the Webull SDK leaves behind. "*.log" doesn't match a name
# that ends in ".1" or a date, so they need their own lines.
bridge.log.*
webull_trade_sdk.log.*

# The day files the bridge writes for backtesting - one per trading day.
# They're his trading record, not code, so they stay on the PC.
days/

# Working files the drill and the chat export leave in the folder.
drill-report.txt
signal-room-chat.txt

# The book's memory across restarts - trading record, not code.
state.json

# helper: local-only junk
_to_delete/
/discord-sniper/

# FUSE mount junk (created when a file is held open over the bridge)
.fuse_hidden*

# the per-trade journal - rebuilt from days/ constantly, data not code
journal.csv

# Trading DATA is not code (8/23 — the pre-start save swept these into git
# and deleting them locally made git resurrect them). Records stay on the PC.
